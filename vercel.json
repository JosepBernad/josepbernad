{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "devCommand": "pnpm run dev",
  "headers": [
    {
      "source": "/:lang(en|es|ca)/availability",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:lang(en|es|ca)/availability/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:lang(en|es|ca)/a/availability",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:lang(en|es|ca)/a/availability/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/availability",  "destination": "/es/availability/", "permanent": false },
    { "source": "/availability/", "destination": "/es/availability/", "permanent": false },
    { "source": "/a/availability",  "destination": "/es/a/availability/", "permanent": false },
    { "source": "/a/availability/", "destination": "/es/a/availability/", "permanent": false },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.josepbernad.com" }],
      "destination": "https://josepbernad.com/:path*",
      "permanent": true
    },

    { "source": "/films",      "destination": "/?next=%2Ffilms%2F",     "permanent": true },
    { "source": "/films/",     "destination": "/?next=%2Ffilms%2F",     "permanent": true },
    { "source": "/about",      "destination": "/?next=%2Fabout%2F",     "permanent": true },
    { "source": "/about/",     "destination": "/?next=%2Fabout%2F",     "permanent": true },
    { "source": "/live",       "destination": "/?next=%2Flive%2F",      "permanent": true },
    { "source": "/live/",      "destination": "/?next=%2Flive%2F",      "permanent": true },
    { "source": "/contact",    "destination": "/?next=%2Fcontact%2F",   "permanent": true },
    { "source": "/contact/",   "destination": "/?next=%2Fcontact%2F",   "permanent": true },
    { "source": "/press-kit",  "destination": "/?next=%2Fpress-kit%2F", "permanent": true },
    { "source": "/press-kit/", "destination": "/?next=%2Fpress-kit%2F", "permanent": true }
  ]
}
